# Application Configuration
APP_NAME="Alzheimer's Disease Early Detection AI"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Default to SQLite for zero-setup local dev, or use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/alzheimers_db
DATABASE_URL=sqlite+aiosqlite:///./alzheimers_ai.db

# Authentication & Security
SECRET_KEY=supersecretjwtkey_change_in_production_32bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage & Uploads
UPLOAD_DIR=./uploads
REPORTS_DIR=./uploads/reports
MAX_UPLOAD_SIZE_MB=25

# ML Model Settings
DEFAULT_MODEL_NAME=custom_cnn
MODEL_WEIGHTS_DIR=./ml/saved_models
IMAGE_SIZE=224
CLASS_NAMES=["Non Demented", "Very Mild Demented", "Mild Demented", "Moderate Demented"]

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
